{
  "name": "drawio-mindmap",
  "private": true,
  "description": "Keyboard-driven mind mapping plugin for draw.io",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "watch": "npm run watch -w packages/plugin",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "spike:ws": "node scripts/ws-echo-server.mjs",
    "drawio:up": "docker compose up -d drawio",
    "drawio:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "ws": "8.23.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
